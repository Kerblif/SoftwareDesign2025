{
  "version": 3,
  "$schema": "https://www.krakend.io/schema/v3.json",
  "port": 8080,
  "endpoints": [
    {
      "endpoint": "/api/v1/orders",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/orders",
          "host": [
            "http://orders-service:8001"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "GET",
      "input_query_strings": [
        "user_id"
      ],
      "backend": [
        {
          "url_pattern": "/orders",
          "host": [
            "http://orders-service:8001"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders/{id}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/orders/{id}",
          "host": [
            "http://orders-service:8001"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/health/orders",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/health",
          "host": [
            "http://orders-service:8001"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/payments/account",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/account",
          "host": [
            "http://payments-service:8002"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/payments/deposit",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/deposit",
          "host": [
            "http://payments-service:8002"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/payments/balance",
      "method": "GET",
      "input_query_strings": [
        "user_id"
      ],
      "backend": [
        {
          "url_pattern": "/balance",
          "host": [
            "http://payments-service:8002"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/health/payments",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/health",
          "host": [
            "http://payments-service:8002"
          ]
        }
      ]
    }
  ]
}
